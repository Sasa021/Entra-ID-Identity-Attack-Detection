{
  "displayName": "LAB DESIGN: Password change for high user risk",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "userRiskLevels": [
      "high"
    ],
    "clientAppTypes": [
      "browser",
      "mobileAppsAndDesktopClients"
    ],
    "applications": {
      "includeApplications": [
        "All"
      ]
    },
    "users": {
      "includeGroups": [
        "REPLACE_WITH_LAB_IDENTITY_USERS_GROUP_OBJECT_ID"
      ],
      "excludeUsers": [
        "REPLACE_WITH_EMERGENCY_ACCESS_1_OBJECT_ID",
        "REPLACE_WITH_EMERGENCY_ACCESS_2_OBJECT_ID"
      ]
    }
  },
  "grantControls": {
    "operator": "AND",
    "builtInControls": [
      "mfa",
      "passwordChange"
    ]
  }
}
